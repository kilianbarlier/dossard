{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Bash(cat *.env*)",
      "Bash(less *.env*)",
      "Bash(more *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(grep *.env*)",
      "Bash(rg *.env*)",
      "Bash(awk *.env*)",
      "Bash(sed *.env*)",
      "Bash(cp *.env*)",
      "Bash(mv *.env*)",
      "Bash(source *.env*)",
      "Bash(. *.env*)",
      "Bash(env)",
      "Bash(printenv*)",
      "Read(./.env)",
      "Edit(scripts/legacy/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pythonP \"$CLAUDE_PROJECT_DIR/.claude/hooks/garde.py\""
          }
        ]
      }
    ]
  }
}
