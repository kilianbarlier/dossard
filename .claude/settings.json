{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Bash(cat *.env*)",
      "Bash(less *.env*)",
      "Bash(more *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(grep *.env*)",
      "Bash(rg *.env*)",
      "Bash(awk *.env*)",
      "Bash(sed *.env*)",
      "Bash(cp *.env*)",
      "Bash(mv *.env*)",
      "Bash(source *.env*)",
      "Bash(. *.env*)",
      "Bash(env)",
      "Bash(printenv*)",
      "Read(./.env)",
      "Edit(scripts/legacy/**)"
    ],
    "allow": ["mcp__dossard__list_views"],
    "ask": ["mcp__dossard__query_view"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/garde.py\""
          }
        ]
      },
      {
        "matcher": "mcp__dossard__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/journal_mcp.py"],
            "onFailure": "block"
          }
        ]
      }

    ]
  }
}
